# ---------------------------------------------------------------------------
# Variables de entorno para PRODUCCIÓN
# ---------------------------------------------------------------------------
# Este archivo es una plantilla de referencia: en el servidor se copia a .env
# y se rellenan los valores. NUNCA se commitea el .env real.
# ---------------------------------------------------------------------------

APP_NAME="Fitnes"
APP_ENV=production
APP_KEY=
# APP_KEY se genera con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://app.tudominio.cl

# El interfaz está en español; los mensajes de validación siguen en inglés
# hasta publicar e traducir el paquete de idioma (pendiente).
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Base de datos ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fitnes
DB_USERNAME=fitnes
DB_PASSWORD=

# --- Sesión y caché ---
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis

# --- Colas: Redis + Horizon ---
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo transaccional (Postmark, Resend o SES en producción) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hola@tudominio.cl"
MAIL_FROM_NAME="${APP_NAME}"

# --- Pasarela de pagos (Mercado Pago) ---
PAYMENT_DRIVER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# En producción SIEMPRE false.
MERCADOPAGO_SANDBOX=false

# --- Video (Bunny Stream) ---
VIDEO_DRIVER=bunny
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# --- Monitoreo de errores (Sentry) ---
# Si se deja vacío, Sentry queda desactivado.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
